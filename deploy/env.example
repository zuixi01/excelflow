# External PostgreSQL, Redis and S3 must be provisioned before `production.sh up`.
EXCEL_AUDITOR_API_TOKEN=replace-with-at-least-32-random-characters
IMAGE_OWNER=zuixi01
DATABASE_URL=postgresql+psycopg://user:password@database.example.com:5432/excel_auditor?sslmode=verify-full
REDIS_URL=rediss://redis.example.com:6379/0
S3_BUCKET=excel-auditor
S3_ENDPOINT_URL=https://s3.example.com
S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_REGION=us-east-1
# Required for a custom S3/MinIO endpoint; leave empty only when using an IAM role.
S3_ACCESS_KEY_ID=replace-with-secret
S3_SECRET_ACCESS_KEY=replace-with-secret
S3_SESSION_TOKEN=
STANDARD_CONNECTIONS_FILE=./connections.empty.json
STANDARD_SECRETS_DIR=./standard-secrets.empty
EXCEL_AUDITOR_ADMIN_USERNAME=admin
EXCEL_AUDITOR_ADMIN_PASSWORD=replace-with-secret
PUBLIC_HOSTNAME=excel.example.com
TLS_CERT_FILE=/secure/excelflow/tls/fullchain.pem
TLS_KEY_FILE=/secure/excelflow/tls/privkey.pem
# Set TLS_CA_FILE when the host does not already trust the issuing company CA.
TLS_CA_FILE=
SERVICE_CA_FILE=/etc/ssl/certs/ca-certificates.crt
MODEL_KEY_FILE=/secure/excelflow/model-key
PLATFORM_KEY_FILE=/secure/excelflow/platform-key
# Model/platform keys must be owned by this host group and mode 640.
SECRET_READ_GID=1000
# The only public entry is the TLS edge. API is private to this Compose network.
EXCEL_AUDITOR_TRUSTED_PROXY_IPS=*
WEB_PORT=8080
EXCEL_AUDITOR_MAX_WORKSPACE_RUNNING_JOBS=8
EXCEL_AUDITOR_MAX_WORKSPACE_QUEUED_JOBS=100
EXCEL_AUDITOR_DEFAULT_OPERATOR_MAX_RUNNING=2
EXCEL_AUDITOR_DEFAULT_OPERATOR_MAX_QUEUED=10
EXCEL_AUDITOR_DEFAULT_OPERATOR_DAILY_LIMIT=100
EXCEL_AUDITOR_LEASE_SECONDS=120
EXCEL_AUDITOR_MAX_RETRIES=3
WORKFLOW_WORKER_REPLICAS=1
WORKFLOW_EXPORT_WORKER_REPLICAS=1
EXCEL_AUDITOR_API_WORKERS=2
EXCEL_AUDITOR_MAPPING_CONCURRENCY=4
EXCEL_AUDITOR_MAPPING_TASK_CONCURRENCY=2

# 8 CPU / 16 GiB internal deployment (load-test before increasing)
EXCEL_AUDITOR_WORKFLOW_MAX_RUNNING=2
EXCEL_AUDITOR_WORKFLOW_MAX_WAITING=50
EXCEL_AUDITOR_WORKFLOW_USER_RUNNING=1
EXCEL_AUDITOR_WORKFLOW_USER_WAITING=3
EXCEL_AUDITOR_MAX_UPLOADS=16
EXCEL_AUDITOR_MODEL_GLOBAL_CONCURRENCY=4
EXCEL_AUDITOR_MIN_FREE_DISK_MIB=2048
